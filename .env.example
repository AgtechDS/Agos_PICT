# ==============================================================================
# agtechdesigne Studio (AGOS Pict) — Environment Configuration Template
# Copy this file to .env and insert your real credentials.
# On Vercel: Configure these variables in Project Settings -> Environment Variables.
# ==============================================================================

# LLMAPI Configuration (Free Tier / Qwen Image Max & Router Fallback)
LLMAPI_BASE_URL=https://api.llmapi.ai/v1
LLMAPI_API_KEY=your_llmapi_api_key_here
LLMAPI_IMAGE_MODEL=qwen-image-max-2025-12-30
LLMAPI_AVAILABLE_MODELS=qwen-image-max-2025-12-30,gemini-3-pro-image,dola-seedream-5-0-pro-260628

# Google Gemini AI Studio Direct (Ultra-HD 50 credits model with character consistency)
GEMINI_API_KEY=your_google_ai_studio_key_here

# Agnes AI Hub (Background & Texture Studio — 100% Free)
AGNESAI_API_KEY=your_agnes_ai_hub_key_here
AGNESAI_BASE_URL=https://apihub.agnes-ai.com/v1

# Hugging Face Token (Optional)
HF_TOKEN=your_huggingface_token_here

# Local Development Server Port (Default: 8300)
PORT=8300

# Supabase Configuration (Authentication, Profiles, Storage & Templates)
SUPABASE_URL=https://mkeykuouwsbjezdgwskq.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
