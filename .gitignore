# ==============================================================================
# agtechdesigne Studio (AGOS Pict) — .gitignore
# MIT-grade Standard: Strict Security & Ephemeral Exclusion
# ==============================================================================

# Credentials, Secrets & Environment Variables (NEVER COMMIT)
.env
.env.*
!.env.example

# Python Bytecode & Runtime Cache
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
venv/
ENV/
env/

# Logs & Debug Data
*.log
server.log
npm-debug.log*
yarn-debug.log*

# Generated Media & Local Outputs
static/outputs/
outputs/
*.tmp

# Vercel Deployment & Build Artifacts
.vercel/

# IDE & Editor Settings
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
